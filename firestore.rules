rules_version = '2';

// Security rules for the Oral Cancer pilot (spec Table 1 consent gate and
// section 7 separation of interfaces).
//
// Model:
//   users/{uid}                         profile + role + consent
//   assessments/{id}                    owned by a patient (owner_uid)
//     assessments/{id}/lesions/{lid}
//     assessments/{id}/clinical/current  written by doctors
//     assessments/{id}/outcome/current   written by doctors
//
// KNOWN PILOT LIMITATION — clinician role is self-assignable.
//
// isDoctor() below accepts EITHER a server-set custom claim
// (request.auth.token.role == 'doctor', set by tools/grant_doctor.mjs) OR the
// `role` field on the user's own profile document, which the client writes after
// an enrolment-code check in the app. The enrolment code ships inside the app
// bundle, so a determined user can read it, self-assign the doctor role, and
// list themselves in the clinician directory. They could then receive and read
// any record a patient chooses to send them.
//
// This is deliberate for pilot convenience: it lets a clinician account be
// created without Admin SDK credentials. Before any real deployment, drop the
// profile-field branch from isDoctor(), forbid client writes of role ==
// 'doctor', make the doctors directory admin-only again, and provision
// clinicians with tools/grant_doctor.mjs.
//
// Mitigation that remains in force: sharing is addressed. A clinician can only
// read a record when the patient explicitly chose them as the recipient, so a
// self-assigned doctor still cannot read anyone else's records.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Preferred: server-set custom claim, which a client cannot forge.
    function hasDoctorClaim() {
      return isSignedIn() && request.auth.token.role == 'doctor';
    }

    // PILOT: also accepts the client-written profile role. See the limitation
    // note at the top of this file.
    function hasDoctorProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor';
    }

    function isDoctor() {
      return hasDoctorClaim() || hasDoctorProfile();
    }

    // ---- users ------------------------------------------------------------
    match /users/{uid} {
      // A user reads and writes only their own profile. Doctors may read any
      // profile so the queue can show patient age/sex and re-check consent.
      allow read: if isSignedIn() && (request.auth.uid == uid || isDoctor());

      // The uid in the document path must match the signed-in user, so nobody
      // can create or overwrite another person's profile.
      //
      // PILOT: a user may write role == 'doctor' on their own profile after the
      // in-app enrolment-code check. This is the self-assignment noted at the
      // top of this file.
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- personal records and habit data ----------------------------------
    // Firestore rules do NOT cascade into subcollections, so the users/{uid}
    // block above does not cover these. Without their own match blocks every
    // write was denied, silently caught, and kept only in memory — so uploaded
    // reports and quit plans were lost when the app closed.
    //
    // Owner-only. Sharing a stored record with a clinician is not wired up yet;
    // when it is, add a doctor-read branch keyed on the record's is_shared flag.
    match /users/{uid}/digilocker_records/{recordId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid}/cessation/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- clinician directory ----------------------------------------------
    // The list a patient chooses a recipient from. Any signed-in user may read
    // it, because a patient must be able to see who they can send a record to.
    // It holds no patient data.
    //
    // PILOT: a clinician lists themselves here at registration, so the entry can
    // only be written under their own uid. Deleting is refused so a listing
    // cannot be silently removed while records are addressed to it.
    match /doctors/{doctorUid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == doctorUid;
      allow delete: if false;
    }

    // ---- patient id reservations ------------------------------------------
    // The document id is the Patient_ID. A patient cannot query `users` to test
    // uniqueness (that would expose other profiles), so registration claims the
    // id here instead. `create` only succeeds when the document does not exist,
    // which makes the claim atomic. Reservations are never editable or
    // removable, so an id cannot be silently reassigned.
    match /patient_ids/{patientId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- assessments ------------------------------------------------------
    match /assessments/{assessmentId} {
      function isOwner() {
        return isSignedIn() && resource.data.owner_uid == request.auth.uid;
      }
      // Sharing is addressed to one clinician, not broadcast. The record must
      // be switched on AND name this reader, so no other clinician can read it.
      function isSharedWithMe() {
        return resource.data.shared_with_doctor == 1
          && resource.data.shared_with_uid == request.auth.uid;
      }

      // The patient owns their assessment. A clinician may read it only when the
      // patient chose them as the recipient. (Live consent is also re-checked in
      // the app against the user profile.)
      allow read: if isOwner() || (isDoctor() && isSharedWithMe());

      // Only the owning patient creates or edits an assessment, and the
      // owner_uid must be their own uid.
      allow create: if isSignedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isOwner()
        && request.resource.data.owner_uid == request.auth.uid;
      allow delete: if isOwner();

      // lesions inherit the parent's access model.
      match /lesions/{lesionId} {
        function parent() {
          return get(/databases/$(database)/documents/assessments/$(assessmentId)).data;
        }
        allow read: if (isSignedIn() && parent().owner_uid == request.auth.uid)
          || (isDoctor()
              && parent().shared_with_doctor == 1
              && parent().shared_with_uid == request.auth.uid);
        allow create, update, delete: if isSignedIn()
          && parent().owner_uid == request.auth.uid;
      }

      // Clinical assessment and outcome are written by doctors and read by the
      // owning patient (to see referral/follow-up) or any doctor.
      match /clinical/{docId} {
        function parent() {
          return get(/databases/$(database)/documents/assessments/$(assessmentId)).data;
        }
        function isMyPatient() {
          return isDoctor()
            && parent().shared_with_doctor == 1
            && parent().shared_with_uid == request.auth.uid;
        }
        allow read: if (isSignedIn() && parent().owner_uid == request.auth.uid)
          || isMyPatient();
        // Only the clinician the record was sent to may record findings on it.
        allow write: if isMyPatient();
      }

      match /outcome/{docId} {
        function parent() {
          return get(/databases/$(database)/documents/assessments/$(assessmentId)).data;
        }
        function isMyPatient() {
          return isDoctor()
            && parent().shared_with_doctor == 1
            && parent().shared_with_uid == request.auth.uid;
        }
        allow read: if (isSignedIn() && parent().owner_uid == request.auth.uid)
          || isMyPatient();
        allow write: if isMyPatient();
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
