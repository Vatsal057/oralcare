rules_version = '2';

// Security rules for the Oral Cancer pilot (spec Table 1 consent gate and
// section 7 separation of interfaces).
//
// Model:
//   users/{uid}                         profile + role + consent
//   assessments/{id}                    owned by a patient (owner_uid)
//     assessments/{id}/lesions/{lid}
//     assessments/{id}/clinical/current  written by doctors
//     assessments/{id}/outcome/current   written by doctors
//
// Clinician access is granted by a server-set custom claim
// (request.auth.token.role == 'doctor'), never by a client-written field. The
// claim can only be set with Admin SDK credentials, so a user cannot promote
// themselves by editing their own profile document. See tools/grant_doctor.mjs
// and docs/FIREBASE_SETUP.md for provisioning.
//
// The `role` field on users/{uid} exists for the interface to render, and the
// rules below forbid a client from writing role == 'doctor' unless the claim is
// already present. It is therefore never a source of privilege.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Server-set custom claim. A missing claim evaluates to null, which never
    // equals 'doctor', so absence fails closed.
    function isDoctor() {
      return isSignedIn() && request.auth.token.role == 'doctor';
    }

    // ---- users ------------------------------------------------------------
    match /users/{uid} {
      // A user reads and writes only their own profile. Doctors may read any
      // profile so the queue can show patient age/sex and re-check consent.
      allow read: if isSignedIn() && (request.auth.uid == uid || isDoctor());

      // The uid in the document path must match the signed-in user, so nobody
      // can create or overwrite another person's profile. Writing the doctor
      // role additionally requires the claim, so self-promotion is impossible
      // even in the profile document the user does own.
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && (request.resource.data.role != 'doctor' || isDoctor());
      allow delete: if false;
    }

    // ---- patient id reservations ------------------------------------------
    // The document id is the Patient_ID. A patient cannot query `users` to test
    // uniqueness (that would expose other profiles), so registration claims the
    // id here instead. `create` only succeeds when the document does not exist,
    // which makes the claim atomic. Reservations are never editable or
    // removable, so an id cannot be silently reassigned.
    match /patient_ids/{patientId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- assessments ------------------------------------------------------
    match /assessments/{assessmentId} {
      function isOwner() {
        return isSignedIn() && resource.data.owner_uid == request.auth.uid;
      }
      function isSharedWithDoctors() {
        return resource.data.shared_with_doctor == 1;
      }

      // The patient owns their assessment. A doctor may read it only when it is
      // shared. (Live consent is also re-checked in the app against the user
      // profile.)
      allow read: if isOwner() || (isDoctor() && isSharedWithDoctors());

      // Only the owning patient creates or edits an assessment, and the
      // owner_uid must be their own uid.
      allow create: if isSignedIn()
        && request.resource.data.owner_uid == request.auth.uid;
      allow update: if isOwner()
        && request.resource.data.owner_uid == request.auth.uid;
      allow delete: if isOwner();

      // lesions inherit the parent's access model.
      match /lesions/{lesionId} {
        function parent() {
          return get(/databases/$(database)/documents/assessments/$(assessmentId)).data;
        }
        allow read: if (isSignedIn() && parent().owner_uid == request.auth.uid)
          || (isDoctor() && parent().shared_with_doctor == 1);
        allow create, update, delete: if isSignedIn()
          && parent().owner_uid == request.auth.uid;
      }

      // Clinical assessment and outcome are written by doctors and read by the
      // owning patient (to see referral/follow-up) or any doctor.
      match /clinical/{docId} {
        function parent() {
          return get(/databases/$(database)/documents/assessments/$(assessmentId)).data;
        }
        allow read: if (isSignedIn() && parent().owner_uid == request.auth.uid)
          || isDoctor();
        allow write: if isDoctor();
      }

      match /outcome/{docId} {
        function parent() {
          return get(/databases/$(database)/documents/assessments/$(assessmentId)).data;
        }
        allow read: if (isSignedIn() && parent().owner_uid == request.auth.uid)
          || isDoctor();
        allow write: if isDoctor();
      }
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
